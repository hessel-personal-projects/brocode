# App
APP_BASE_URL=http://localhost:3000

# Supabase (local defaults printed by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service_role-key-from-supabase-start
SUPABASE_STORAGE_BUCKET=brocode-assets

# Postgres (local Supabase — no pooler locally, both URLs identical)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Email — AWS SES SMTP
EMAIL_TRANSPORT=capture
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_FROM_ADDRESS=Brocode <no-reply@yourdomain.com>
SES_REGION=us-east-1
SNS_TOPIC_ARN=
